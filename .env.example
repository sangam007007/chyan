# ─── Server ────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database (PostgreSQL 16) ─────────────────────────
DB_URL=postgresql://postgres:postgres@localhost:5432/up_police_test_series

# ─── Cache (Redis 7) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Secrets ──────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-access-token-secret-here
JWT_REFRESH_SECRET=your-refresh-token-secret-here

# ─── SMS Gateway ──────────────────────────────────────
SMS_API_KEY=your-sms-api-key-here
SMS_API_URL=https://api.sms-provider.com/send

# ─── Google OAuth 2.0 ─────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── CAPTCHA ──────────────────────────────────────────
CAPTCHA_SECRET=your-captcha-secret-key

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── File Storage ─────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_AVATAR_SIZE_MB=2

# ─── Rank Estimator ───────────────────────────────────
# Total number of applicants for rank estimation formula
RANK_TOTAL_APPLICANTS=50000
# Maximum possible marks (default: 150)
RANK_TOTAL_MARKS=150
