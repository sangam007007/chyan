# Copy to deploy/.env.production and fill in. Never commit the real file.
NODE_ENV=production
PORT=4000
DB_URL=postgres://chayan:CHANGE_ME@postgres:5432/chayan
REDIS_URL=redis://redis:6379
# generate: openssl rand -hex 48   (use two different values)
JWT_SECRET=
JWT_REFRESH_SECRET=
# OTP is printed in `docker compose logs app` (no real SMS yet)
SMS_MODE=console
SMS_API_KEY=dummy
SMS_API_URL=https://example.invalid/sms
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_CALLBACK_URL=https://YOUR_DOMAIN/api/auth/google/callback
CAPTCHA_SECRET=dummy
CORS_ORIGIN=https://YOUR_DOMAIN
TRUST_PROXY=1
# processes per container; set to number of CPU cores
WEB_CONCURRENCY=2
# total = WEB_CONCURRENCY x DB_POOL_MAX must stay under Postgres max_connections (100)
DB_POOL_MAX=10
RANK_TOTAL_APPLICANTS=100000
UPLOAD_DIR=./uploads

# read by docker-compose itself (put in deploy/.env or export before running)
# DOMAIN=chayan.example.com
# POSTGRES_PASSWORD=same as in DB_URL
# VITE_SUPPORT_CONTACT=your WhatsApp/email
